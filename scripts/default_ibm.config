# ==============================================================================
# Biological Individual-Based Model (BIBM) Default Configuration
# ==============================================================================
# This file defines the complete set of parameters for the BIBM engine.
# It is organized by functional group to facilitate customization and
# species-specific modeling.
#
# Structure:
#   [simulation]        - Core execution, time stepping, and feature toggles
#   [environment]       - External drivers (temperature, food)
#   [organism]          - Generic morphometric and energetic parameters
#   [species_snowcrab]  - Snow crab specific biological rules
#   [phenology]         - Seasonal windows for life-history events
#   [mortality]         - Drivers of individual death/removal
#   [fishery]           - Human interaction and harvest parameters
#   [output]            - Data serialization and visualization settings
# ==============================================================================

[simulation]
# --- Feature Toggles (Modular Architecture) ---
use_energetics      = true
use_thermal_stress  = true
use_food_dynamics   = true
use_habitat_taxis   = true
use_cannibalism     = true
use_senescence      = true
use_reproduction    = true
use_recruitment     = true

# --- Execution Parameters ---
dt                  = 1.0         # Time step in days
seed                = 1234      # RNG seed for reproducibility
n_agents             = 300       # Initial population size (for adult/juvenile agents)
days                = 730       # Total simulation duration (days)
grid_nx             = 100       # Spatial grid width
grid_ny             = 100       # Spatial grid height

[binning]
use_bins            = true      # Use aggregate distributions for early stages?
n_age_bins          = 50        # Number of age bins (for non-spatial populations)
n_size_bins         = 20        # Number of size/length bins
min_size            = 1.0       # Minimum bin edge [mm]
max_size            = 100.0     # Maximum bin edge for early stages [mm]

[environment]
# --- Thermal Regime ---
temp_base           = 5.0       # Annual baseline temperature (°C)
temp_amplitude      = 4.0       # Seasonal oscillation amplitude (°C)
temp_noise_sd       = 0.5       # Spatial thermal stochasticity (SD)
temp_base_degreedays = 0.0      # Base threshold for degree-day accumulation

# --- Food & Resource Dynamics ---
food_max            = 10.0      # Maximum local benthic food density
food_replenishment_rate = 0.1   # Daily replenishment increment per cell
benthic_carrying_capacity = 300.0 # Regional carrying capacity target
half_saturation_food = 2.0      # Half-saturation constant for intake
assimilation_efficiency = 0.75  # Efficiency of food to energy conversion

[organism]
# --- Generic Morphometry & Energy ---
max_size_male       = 160.0     # Max size (mm)
max_size_female     = 95.0      # Max size (mm)
maturity_size_mid   = 60.0      # Median size at maturity (mm)

metabolic_rate_base = 0.01      # Basal metabolic coefficient
intake_rate_base    = 0.15      # Saturation-limit ingestion coeff (g^0.75 d^-1)

energy_molt_threshold  = 50.0   # Energy required to trigger molt
energy_molt_slope      = 1.5    # Allometric scaling of molt requirement
molt_energy_retention  = 0.10   # Fraction of energy retained post-ecdysis

min_mating_energy_fraction = 0.1 # Min energy fraction for mating eligibility
initial_energy             = 10.0 # Starting metabolic reserve
molt_probability_scale     = 45.0 # Scale for molt probability

[species_snowcrab]
# --- Maturity (Log-Logistic Ogives) ---
maturity_l50_male      = 91.8
maturity_l50_male_sd   = 1.2
maturity_slope_male    = 6.9957
maturity_slope_male_sd = 0.25

maturity_l50_female     = 51.6
maturity_l50_female_sd  = 0.8
maturity_slope_female   = 12.9812
maturity_slope_female_sd = 0.40

# --- Fecundity (Empirical Models) ---
# Note: Primiparous and Multiparous parameters are hardcoded in empirical_biology.jl

# --- Growth (Bivariate Normal: Intercept & Slope) ---
growth_int_female    = 0.1931
growth_beta1_female  = 0.0545
growth_slp_female    = 1.0372
growth_beta2_female  = -0.017376
growth_beta3_female  = 0.005068

growth_int_male      = 0.30153
growth_beta1_male    = 0.02198
growth_slp_male      = 1.00027
growth_beta2_male    = -0.00643655
growth_beta3_male    = 0.0017492

# --- Gear Selectivity ---
selectivity_s50       = 95.0
selectivity_s50_sigma = 5.0

[phenology]
# --- Seasonal Windows (Day of Year: 1-365) ---
molt_season_start    = 15.0
molt_season_end      = 140.0
mating_season_start  = 30.0
mating_season_end    = 120.0

# --- Life History Timing & Success ---
mating_search_radius = 5       # Search radius in grid cells
brood_duration_base  = 365.0   # Incubation duration (days)
egg_survival_base    = 5.0e-5  # Survival from egg to recruit

[mortality]
soft_shell_duration       = 30.0 # Duration of post-molt vulnerability (days)
senescence_age_threshold  = 3.0  # Age threshold for increased mortality (years)
temp_thermal_stress       = 8.0  # Temperature onset for thermal stress (°C)

[fishery]
legal_size_male             = 95.0 # Minimum legal size (mm)
fishing_probability_daily   = 0.0  # Daily harvest probability
fishing_season_start        = 90.0 # Opening day of year
fishing_season_end          = 150.0 # Closing day of year

[output]
save             = true
save_file        = "simulation_results.csv"
snapshot_day     = 274.0         # Day for annual survey snapshot
frequency_days   = 365.0         # Output sampling interval (days)
plot             = false
output_dir       = "outputs"
animate          = false
animation_file   = "snowcrab_animation.mp4"
anim_frames      = 120
anim_dt          = 2
anim_fps         = 15
anim_field       = "temperature"
