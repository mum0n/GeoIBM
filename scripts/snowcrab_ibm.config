# ==============================================================================
# Snow Crab Individual-Based Model (IBM) Default Configuration
# ==============================================================================
# This configuration file defines default parameters for the spatially explicit
# individual-based model (IBM) of snow crab (Chionoecetes opilio).
#
# Sections:
#   [simulation]  - Grid geometry, population size, duration, time step, RNG seed
#   [environment] - Thermal regime, food carrying capacity and replenishment
#   [biology]     - Asymptotic size, bioenergetics, molt thresholds, degree-days
#   [phenology]   - Seasonal windows for molting, mating, brood duration
#   [fishery]     - Legal size minimum, harvest probabilities, open season window
#   [output]      - Data serialization, output directories, and figure generation
# ==============================================================================

[simulation]
# Model complexity level: 'simple' (default) or 'complex'
# 'simple': basic model without temperature interactions, degree-days, carapace condition,
#           food limitation, or spermathecal storage; using time/age-based molting & maturation.
# 'complex': fully detailed IBM with mass-based bioenergetics, temperature interactions,
#            degree-day accumulation, shell condition dynamics, and spermathecal storage.
model = "simple"

# Initial number of juvenile crabs seeded into the model
n_agents = 300

# Total simulation run duration in days (730 days = 2 calendar years)
days = 730

# Discrete spatial grid dimensions [nx, ny] in grid cells
grid = [100, 100]

# Discrete simulation time step in days
dt = 1.0

# Random number generator seed for deterministic reproducibility
seed = 1234

[environment]
# Annual baseline bottom water temperature in degrees Celsius (°C)
temp_base = 5.0

# Seasonal bottom temperature oscillation amplitude in degrees Celsius (°C)
temp_amplitude = 4.0

# Spatial temperature stochasticity standard deviation in degrees Celsius (°C)
temp_noise_sd = 0.50

# Maximum local benthic food density per grid cell (arbitrary biomass units)
food_max = 10.0

# Daily food replenishment increment per grid cell
food_replenishment_rate = 0.10

# Regional carrying capacity target for total benthic crab abundance
benthic_carrying_capacity = 300.0

[biology]
# Asymptotic maximum carapace width for males in millimeters (mm)
max_size_male = 160.0

# Asymptotic maximum carapace width for females in millimeters (mm)
max_size_female = 95.0

# Nominal median carapace width at morphometric maturity in millimeters (mm)
maturity_size_mid = 60.0

# Basal metabolic coefficient for standard metabolic rate scaling
metabolic_rate_base = 0.01

# Basal food intake coefficient for feeding and consumption
intake_rate_base = 0.05

# Intercept of energetic molt requirement equation
energy_molt_threshold = 50.0

# Allometric scaling slope of energetic molt requirement
energy_molt_slope = 1.5

# Fraction of surplus energy reserve retained after ecdysis (0.0 to 1.0)
molt_energy_retention = 0.10

# Base physiological threshold temperature for cumulative degree-days (°C)
temp_base_degreedays = 0.0

[phenology]
# Day of calendar year (1-365) marking onset of adolescent molting window
molt_season_start = 15.0

# Day of calendar year (1-365) marking termination of molting window
molt_season_end = 140.0

# Day of calendar year (1-365) marking onset of spring mating season
mating_season_start = 30.0

# Day of calendar year (1-365) marking conclusion of spring mating season
mating_season_end = 120.0

# Spatial search radius in grid cells for detecting receptive mating partners
mating_search_radius = 5

# Baseline embryo brooding incubation duration in days (~1 calendar year)
brood_duration_base = 365.0

# Baseline survival probability from extruded egg to settled benthic instar 4
egg_survival_base = 5.0e-5

[fishery]
# Minimum legal carapace width for commercial harvest retention in mm
legal_size_male = 95.0

# Daily harvest probability on legal-sized males during open season
fishing_probability_daily = 0.0

# Day of calendar year (1-365) marking commercial fishery opening
fishing_season_start = 90.0

# Day of calendar year (1-365) marking commercial fishery closing
fishing_season_end = 150.0

[output]
# Save annual population and macro-ecological time-series results to disk
save = true

# Output filename for saved simulation results (CSV format)
save_file = "simulation_results.csv"

# Day of calendar year (1-365) to record annual survey snapshot outputs (default: 274.0 = ~1 September)
snapshot_day = 274.0

# Output frequency in days at which simulation results are recorded (default: 365.0 days = 1 year)
frequency_days = 365.0

# Flag to generate and export diagnostic summary plots and figures
plot = false

# Directory path for saved figures, diagnostics, and output CSV data
output_dir = "outputs"

[animation]
# Flag to generate and record spatial ABM animation video/gif using Agents.abmvideo
animate = false

# Filename for generated animation video (supports .mp4, .gif, .webm)
animation_file = "snowcrab_animation.mp4"

# Total number of frames recorded in animation
anim_frames = 120

# Number of simulation days advanced per animation frame
anim_dt = 2

# Animation playback framerate in frames per second
anim_fps = 15

# Environmental background heatarray field ('temperature' or 'food')
anim_field = "temperature"

